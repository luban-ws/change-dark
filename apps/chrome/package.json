{
    "name": "@change-dark/chrome",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "vite",
        "icons": "node scripts/generate-extension-icons.mjs",
        "build": "vite build",
        "pack": "vite build && node scripts/pack-extension-zip.mjs",
        "preview": "vite preview",
        "test": "vitest run",
        "test:e2e": "playwright test",
        "test:e2e:install": "playwright install chromium",
        "test:e2e:report": "playwright show-report",
        "lint": "tsc -p tsconfig.json --noEmit"
    },
    "dependencies": {
        "@change-dark/site-catalog": "workspace:*",
        "@change-dark/dark-engine": "workspace:*",
        "@change-dark/dynamic-recolor": "workspace:*",
        "@change-dark/extension-settings": "workspace:*",
        "@change-dark/injected-styles": "workspace:*",
        "@radix-ui/themes": "^3.3.0",
        "i18next": "^26.0.3",
        "lucide-react": "^1.7.0",
        "react": "^18.3.1",
        "react-dom": "^18.3.1",
        "react-i18next": "^17.0.2"
    },
    "devDependencies": {
        "@crxjs/vite-plugin": "^2.0.0-beta.26",
        "@playwright/test": "^1.59.1",
        "@testing-library/jest-dom": "^6.9.1",
        "@testing-library/react": "^16.2.0",
        "@types/chrome": "^0.0.279",
        "@types/node": "^22.10.1",
        "@types/react": "^18.3.18",
        "@types/react-dom": "^18.3.5",
        "@vitejs/plugin-react": "^4.3.4",
        "@vitest/coverage-v8": "2.1.9",
        "jsdom": "^25.0.1",
        "sharp": "^0.34.5",
        "typescript": "^5.7.3",
        "vite": "^5.4.11",
        "vite-plugin-top-level-await": "^1.6.0",
        "vite-plugin-wasm": "^3.6.0",
        "vitest": "^2.1.8"
    }
}
