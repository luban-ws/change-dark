{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "types": ["chrome", "vite/client", "node"],
    "jsx": "react-jsx"
  },
  "include": ["src", "manifest.config.ts", "vite.config.ts", "vitest.config.ts", "e2e"]
}
